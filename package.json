  },
  "devDependencies": {
    "@quasar/app-vite": "^3.4.1",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "typescript": "^7.0.0",
