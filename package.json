{
  "name": "maps",
  "version": "0.0.1",
  "private": true,
  "description": "For displaying pmtiles.",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Karn Wong <karn@karnwong.me>",
  "type": "module",
  "scripts": {
